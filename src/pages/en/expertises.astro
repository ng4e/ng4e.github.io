---
import Layout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import CompanyLogoSlider from "../../components/CompanyLogoSlider.astro";
import { companies } from "../../consts";
import { Eye, FolderKanban, Code, Users, Wrench } from "@lucide/astro";
import { t, type Locale } from "../../i18n/translations";

const locale = (Astro.currentLocale ?? "en") as Locale;

const expertises = [
  {
    icon: Eye,
    title: t("expertises.vision.title", locale),
    level: t("expertises.vision.level", locale),
    body: t("expertises.vision.body", locale),
  },
  {
    icon: FolderKanban,
    title: t("expertises.project.title", locale),
    level: t("expertises.project.level", locale),
    body: t("expertises.project.body", locale),
  },
  {
    icon: Code,
    title: t("expertises.fullstack.title", locale),
    level: t("expertises.fullstack.level", locale),
    body: t("expertises.fullstack.body", locale),
  },
  {
    icon: Users,
    title: t("expertises.agile.title", locale),
    level: t("expertises.agile.level", locale),
    body: t("expertises.agile.body", locale),
  },
  {
    icon: Wrench,
    title: t("expertises.tech.title", locale),
    level: "",
    body: t("expertises.tech.body", locale),
  },
];

const sectors = [
  t("sectors.retail_banking", locale),
  t("sectors.insurance", locale),
  t("sectors.payment", locale),
  t("sectors.telecom", locale),
  t("sectors.energy", locale),
];
---

<Layout
  title={t("expertises.pageTitle", locale)}
  description={t("expertises.pageDesc", locale)}
  headerTitle={t("expertises.pageTitle", locale)}
  locale={locale}
>
  <section class="bg-white py-20 animate-on-scroll" data-animate>
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-semibold text-primary text-center mb-4">
        {t("expertises.header", locale)}
      </h2>
      <p class="text-base text-text-secondary text-center mb-8 max-w-2xl mx-auto">
        {t("expertises.subtitle", locale)}
      </p>

      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {sectors.map((sector) => (
          <Badge>{sector}</Badge>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {expertises.map(({ icon: Icon, title, level, body }, i) => (
          <div class="stagger-item" style={`--stagger-delay: ${i}`}>
            <Card>
              <Icon class="w-12 h-12 text-accent mb-4" stroke-width={2} />
              <h3 class="text-xl font-semibold text-primary mb-1">{title}</h3>
              {level && <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-2">{level}</p>}
              <p class="text-base text-text-secondary">{body}</p>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 animate-on-scroll" data-animate>
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-semibold text-primary text-center mb-8">{t("expertises.clients.title", locale)}</h2>
      <CompanyLogoSlider companies={companies} />
    </div>
  </section>
</Layout>
