---
import Layout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import Button from "../../components/ui/Button.astro";
import { Download } from "@lucide/astro";
import { t, type Locale } from "../../i18n/translations";

const locale = (Astro.currentLocale ?? "en") as Locale;

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.key - b.data.key,
);

const pdfPath = "/assets/MOLU_N_Samuel_CV_FR_v042025.2-2.pdf";
---

<Layout title={t("experiencesPage.pageTitle", locale)} description={t("experiencesPage.pageDesc", locale)} headerTitle={t("experiencesPage.headerTitle", locale)} locale={locale}>
  <section class="bg-white py-12 reveal">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between">
      <div>
        <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-2">{t("experiencesPage.header", locale)}</h2>
        <p class="text-base text-text-secondary">{t("experiencesPage.subtitle", locale)}</p>
      </div>
      <Button variant="ghost" href={pdfPath} class="mt-4 sm:mt-0">
        <Fragment slot="icon"><Download class="w-5 h-5" /></Fragment>
        {t("experiencesPage.cv.download", locale)}
      </Button>
    </div>
  </section>

  <section class="bg-surface py-20 reveal">
    <div class="max-w-4xl mx-auto px-4 space-y-8">
      {projects.map((project, i) => (
        <div class="stagger-item" style={`--stagger-delay: ${i}`} id={project.data.id}>
          <ProjectCard project={project.data} locale={locale} />
        </div>
      ))}
    </div>
  </section>
</Layout>
