---
import Layout from "../layouts/BaseLayout.astro";
import CompanyLogoSlider from "../components/CompanyLogoSlider.astro";
import { companies } from "../consts";
---

<Layout
    title="Expertises"
    description="Architecture et planification - Integration de systemes - Conception et developpement de logiciels"
>

    <p>Ouvert au marche. Freelance/CDI. base a Aix-en-Provence</p>
    <h5>15+ annees d'experience, dans des secteurs strategiques</h5>
    <div>
        <span>Banque de detail</span>
        <span>Assurance</span>
        <span>Monetique</span>
        <span>Telecom</span>
        <span>Energie</span>
    </div>

    <div>
        <div>
            <div>
                <header>
                    <p>Vision Produit (Experimente)</p>
                </header>
                <div>
                    <p>
                        Definition et mise en oeuvre de la strategie produit
                        cote backend avec un fort focus sur le modele,
                        l'ergonomie et la performance
                    </p>
                </div>
            </div>
        </div>

        <div>
            <div>
                <header>
                    <p>Gestion de projet technique (Experimente)</p>
                </header>
                <div>
                    <p>
                        Pilotage et Implementation de projets techniques de la
                        conception au deploiement
                    </p>
                </div>
            </div>
        </div>

        <div>
            <div>
                <header>
                    <p>Developpement full-stack (Experimente)</p>
                </header>
                <div>
                    <p>
                        Sensibilite a une approche de developpement cloud natif.
                        Langages de programmation: Java 8+, JavaScript (ES6+),
                        TypeScript, Python SQL.
                    </p>
                </div>
            </div>
        </div>

        <div>
            <div>
                <header>
                    <p>Environnement agile et apprenant (Experimente)</p>
                </header>
                <div>
                    <p>
                        Capacite a evoluer dans un cadre collaboratif et oriente
                        vers le client, avec une capacite d'apprentissage
                        continue.
                    </p>
                </div>
            </div>
        </div>

        <div>
            <div>
                <header>
                    <p>Competences Techniques Complementaires</p>
                </header>
                <div>
                    <p>
                        Atlassian (Confluence, Jira,Trello), Spring Boot, Spring
                        framework, Quarkus, Maven, Github, Gitlab, Bitbucket,
                        Vercel, Google Cloud, AWS, Oracle Cloud.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <CompanyLogoSlider companies={companies} />
</Layout>
