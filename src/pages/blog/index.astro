---
import Layout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Idées et Opinions"
    description="...et autres questions existentielles sur la technologie, la science et la vie de tous les jours"
>
    <section class="section">
        {
            posts.map((post) => (
                <div class="blog-post-item">
                    <article class="media">
                        <div class="media-content">
                            <div class="content">
                                <p>
                                    <strong>
                                        <a
                                            href={`/blog/${post.id}/`}
                                            aria-label={`Read ${post.data.title}`}
                                        >
                                            {post.data.title}
                                        </a>
                                    </strong>
                                    <br />
                                    <small>
                                        <FormattedDate
                                            date={post.data.pubDate}
                                        />
                                    </small>
                                    <br />
                                    {post.data.description}{" "}
                                    {/* Added description instead of image */}
                                    <br />
                                    <a
                                        href={`/blog/${post.id}/`}
                                        aria-label={`Read more about ${post.data.title}`}
                                    >
                                        Read more
                                    </a>
                                </p>
                            </div>
                        </div>
                    </article>
                </div>
            ))
        }
    </section>
    <style>
        .blog-post-item {
            border-bottom: 1px solid #ddd; /* Subtle bottom border */
            margin-bottom: 2rem; /* Space between items */
            padding-bottom: 1rem; /* Adds space for the border */
            font-family: serif; /* Journal-like font */
        }

        .content {
            font-size: 1.1rem; /* Adjust font size for readability */
            line-height: 1.6; /* Improves readability */
        }

        strong a {
            color: inherit; /* Inherit the text color for the link */
            text-decoration: none; /* Remove underline from the link */
        }
        strong a:hover {
            text-decoration: underline; /* Add underline on hover */
        }
    </style>
</Layout>
