---
import Layout from "../layouts/BaseLayout.astro";
import { t, type Locale } from "../i18n/translations";
import HeroSection from "../components/sections/HeroSection.astro";
import HeroBackground from "../components/ui/HeroBackground.tsx";
import PhilosophySection from "../components/sections/PhilosophySection.astro";
import CompetenciesSection from "../components/sections/CompetenciesSection.astro";
import SectorsSection from "../components/sections/SectorsSection.astro";
import MetricsSection from "../components/sections/MetricsSection.astro";
import ProductsSection from "../components/sections/ProductsSection.astro";
import BlogPreviewSection from "../components/sections/BlogPreviewSection.astro";

const locale = (Astro.currentLocale ?? "fr") as Locale;
---

<Layout title={t("site.title", locale)} description={t("site.description", locale)} sentinelInHero={true} locale={locale}>
  <HeroSection locale={locale}>
    <HeroBackground client:load slot="background" />
  </HeroSection>
  <PhilosophySection locale={locale} />
  <CompetenciesSection locale={locale} />
  <SectorsSection locale={locale} />
  <MetricsSection locale={locale} />
  <ProductsSection locale={locale} />
  <BlogPreviewSection locale={locale} />
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "GambeTech",
    "url": "https://gambetech.com",
    "logo": "https://gambetech.com/gambetech-logo-192x192.png",
    "description": "Editeur de logiciels specialise dans les produits de niche",
    "foundingDate": "2020",
    "sameAs": [
      "https://github.com/nicogambe",
      "https://linkedin.com/in/nicolasgamberini"
    ]
  }
  </script>
</Layout>
