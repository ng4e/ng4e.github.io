---
import Layout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import HeroSection from "../components/sections/HeroSection.astro";
import HeroBackground from "../components/ui/HeroBackground.tsx";
import PhilosophySection from "../components/sections/PhilosophySection.astro";
import CompetenciesSection from "../components/sections/CompetenciesSection.astro";
import SectorsSection from "../components/sections/SectorsSection.astro";
import MetricsSection from "../components/sections/MetricsSection.astro";
import ProductsSection from "../components/sections/ProductsSection.astro";
import BlogPreviewSection from "../components/sections/BlogPreviewSection.astro";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} sentinelInHero={true}>
  <HeroSection>
    <HeroBackground client:load slot="background" />
  </HeroSection>
  <PhilosophySection />
  <CompetenciesSection />
  <SectorsSection />
  <MetricsSection />
  <ProductsSection />
  <BlogPreviewSection />
</Layout>
