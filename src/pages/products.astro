---
import Layout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/case-study/CaseStudyCard.astro";
import { getPublishedCaseStudies } from "../lib/case-studies";
import { t, type Locale } from "../i18n/translations";

const locale = (Astro.currentLocale ?? "fr") as Locale;
// Published product case studies only (docs/architecture/case-studies.md §3), by `order`.
const products = (await getPublishedCaseStudies()).filter((entry) => entry.data.kind === "product");
---

<Layout
  title={t("productsPage.pageTitle", locale)}
  description={t("productsPage.pageDesc", locale)}
  headerTitle={t("productsPage.header", locale)}
  locale={locale}
>
  <section class="bg-white py-20 reveal">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-semibold text-primary text-center mb-4">{t("productsPage.header", locale)}</h2>
      <p class="text-base text-text-secondary text-center mb-12 max-w-2xl mx-auto">
        {t("productsPage.subtitle", locale)}
      </p>
      {products.length > 0 ? (
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {products.map((entry) => (
            <li><CaseStudyCard entry={entry} locale={locale} /></li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-text-secondary">{t("productsPage.empty", locale)}</p>
      )}
    </div>
  </section>
</Layout>
