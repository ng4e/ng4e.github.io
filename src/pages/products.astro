---
import Layout from "../layouts/BaseLayout.astro";

const products = [
    {
        title: "Association Sportifs Prometteurs",
        description:
            "L'association accompagne de joueurs de tennis de niveau national vers la carriere professionnelle.",
        requirements: "Developpe une solution de programmation de tournois a partir des performances envisagees et du budget",
        architecture: "node, express, ts, ejs, appwrite, bitbucket, SonarQube, Oracle cloud",
        website: "https://getsp.sportifs-prometteurs.org/"
    },
    {
        title: "Association Pirien",
        description:
            "Pour la preservation, la valorisation, et la transmission de l'heritage culturel materiel et immateriel de mon ethnie au Cameroun : Les Bamouns",
        requirements: "Boutique associative en ligne",
        architecture: "strikingly, square",
        website: "https://why.pirien.com"
    },
    {
        title: "NMT",
        description:
            "NG. Moving Together est un reseau social familliale avec arbre genealogique, journal de gratitude partage a destination des familles eloignees par l'immigration",
        requirements: "Creer un Backend Securise pour une application mobile en Frontend",
        architecture: "Spring boot, Neo4j, Postgres, Appwrite, Bitbucket, Docker SonarQube, Oracle Cloud, HugginFace, Mistra AI",
        website: "#",
    }
];
---

<Layout
    title="Nos Produits"
    description="Creer de la valeur sur des problemes de niches"
    headerTitle="Nos Produits"
>
    <section>
        <div>
            <div>
                {
                    products.map((product) => (
                        <div>
                            <div>
                                <div>
                                    <p><strong>{product.title}</strong></p>
                                    <p>{product.description}</p>
                                    <hr />
                                    <div>
                                        <p>
                                            <strong>Requirements:</strong>
                                            <br />
                                            {product.requirements}
                                        </p>
                                        <p>
                                            <strong>Architecture:</strong>
                                            <br />
                                            {product.architecture}
                                        </p>
                                    </div>
                                    {product.website && (
                                        <div>
                                            <a
                                                href={product.website}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`Visit the website for ${product.title}`}
                                            >
                                                Site Web
                                            </a>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
