---
import Layout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { companies } from "../consts";
import ProjectCard from "../components/ProjectCard.astro";

// Get all projects from the collection
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.key - b.data.key,
);

// Assumes your PDF file is in the `public/` directory.
const pdfPath = "/assets/MOLU_N_Samuel_CV_FR_v042025.2-2.pdf";
const pdfFileName = "MOLU_N_Samuel_CV_FR_v042025.2-2.pdf";
---

<Layout title="References" description="15+ Annees d'experiences">
    {projects.map((project) => (
      <section id={`${project.data.id}`}>
        <ProjectCard project={project.data} />
      </section>
    ))}
</Layout>
