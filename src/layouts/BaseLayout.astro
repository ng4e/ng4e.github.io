---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import type { Locale } from "../i18n/translations";

interface Props {
    title: string;
    description: string;
    headerTitle?: string;
    headerSubtitle?: string;
    sentinelInHero?: boolean;
    locale?: Locale;
}

const { title, description, headerTitle, headerSubtitle, sentinelInHero } = Astro.props;
const locale = Astro.props.locale ?? (Astro.currentLocale as Locale) ?? "fr";
---

<html lang={locale}>
    <head>
        <BaseHead title={title} description={description} />
        <script
            is:inline
            async
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="39958342-9d1d-4dda-9dce-afd9b531a14e"></script>
    </head>
    <body class="bg-bg text-text font-sans">
        <Navbar locale={locale} />
        {headerTitle && (
            <header class="bg-primary pt-24 pb-12">
                <div class="max-w-7xl mx-auto px-4 text-center">
                    <h1 class="text-white text-4xl font-semibold">{headerTitle}</h1>
                    {headerSubtitle && (
                        <p class="text-white/80 text-lg mt-2">{headerSubtitle}</p>
                    )}
                </div>
            </header>
        )}
        {!sentinelInHero && <div id="nav-sentinel" class="h-0" aria-hidden="true"></div>}
        <main><slot /></main>
        <Footer locale={locale} />
    </body>
</html>
