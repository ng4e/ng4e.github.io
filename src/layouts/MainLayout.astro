---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroHead from "../components/HeroHead.astro";

const { title, description } = Astro.props;
---

<html lang="fr">
    <head>
        <BaseHead title={title} description={description} />
        <script
            is:inline
            async
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="39958342-9d1d-4dda-9dce-afd9b531a14e"></script>
    </head>
    <body class="container">
        <Header />
        <section class="hero is-fullheight-with-navbar">
            <div class="hero-head">
                <HeroHead title={title} subtitle={description} />
            </div>
            <div class="hero-body">
                <div class="content">
                    <slot />
                </div>
            </div>
            <div class="hero-foot">
               <!-- <Footer /> -->
            </div>
        </section>
    </body>
</html>
