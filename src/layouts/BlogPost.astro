---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import HeroHead from "../components/HeroHead.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="fr">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body class="container">
        <Header />
        <section class="hero is-fullheight-with-navbar">
            <div class="hero-head">
                <HeroHead title={title} subtitle={description} />
                <div class="">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <div class="last-updated-on">
                                Last updated on{" "}
                                <FormattedDate date={updatedDate} />
                            </div>
                        )
                    }
                </div>
            </div>
            <div class="hero-body">
                <article>
                    <div class="prose">
                        <slot />
                    </div>
                </article>
            </div>
            <div class="hero-foot">
                <Footer />
            </div>
        </section>
    </body>
    <style>


                .hero-head {
                    padding: 1rem;
                    border-bottom: 1px solid #ddd; /* Light divider */
                }

                .hero-body {
                    padding: 2rem;
                }

                article {
                    max-width: 800px; /* Max width for readability */
                    margin: 0 auto;
                }

                /* Prose Styles (override Bulma defaults where needed) */
                .prose {
                    font-family: "Georgia", serif;
                    line-height: 1.7;
                    color: #333;

                    /* Headings */
                    h1, h2, h3, h4, h5, h6 {
                        font-family: "Helvetica Neue", sans-serif;
                        font-weight: bold;
                        color: #222;
                        margin-top: 1.5em;
                        margin-bottom: 0.5em;
                        line-height: 1.3;
                    }

                    h1 { font-size: 2.5em; }
                    h2 { font-size: 2em; }
                    h3 { font-size: 1.75em; }
                    h4 { font-size: 1.5em; }
                    h5 { font-size: 1.25em; }
                    h6 { font-size: 1em; }

                    /* Paragraphs */
                    p {
                        margin-bottom: 1.5em;
                    }

                    /* Links */
                    a {
                        color: #007bff; /* Bulma's primary color or a similar blue */
                        text-decoration: none;
                    }

                    a:hover {
                        text-decoration: underline;
                    }

                    /* Lists */
                    ul, ol {
                        margin-left: 2em;
                        margin-bottom: 1.5em;
                    }

                    li {
                        margin-bottom: 0.5em;
                    }

                    /* Images */
                    img {
                        max-width: 100%;
                        height: auto;
                        display: block;
                        margin: 1em auto;
                    }

                    /* Code */
                    pre {
                        background-color: #f5f5f5;
                        padding: 1em;
                        overflow-x: auto;
                        border-radius: 5px;
                    }

                    code {
                        font-family: monospace;
                        background-color: #f5f5f5;
                        padding: 0.2em 0.4em;
                        border-radius: 3px;
                    }

                    /* Blockquotes */
                    blockquote {
                        border-left: 4px solid #ccc;
                        padding-left: 1em;
                        margin-left: 0;
                        margin-right: 0;
                        font-style: italic;
                        color: #555;
                    }
                }

                .last-updated-on {
                    font-size: 0.85em;
                    color: #777;
                    margin-top: 0.5em;
                }
            </style>
</html>
