---
import Layout from "../../layouts/BaseLayout.astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import { LINKEDIN_URL } from "../../consts";
import { t, type Locale } from "../../i18n/translations";
import type { CaseStudy } from "../../lib/case-studies";

interface Props {
  entry: CaseStudy;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { data } = entry;
const content = data[locale];

// Plain-text fields: one <p> per blank-line-separated paragraph.
const paragraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

const sections = [
  { heading: t("caseStudy.problem", locale), text: content.problem },
  { heading: t("caseStudy.built", locale), text: content.built },
  { heading: t("caseStudy.production", locale), text: content.production },
];
const closingSections = [
  { heading: t("caseStudy.role", locale), text: content.role },
  { heading: t("caseStudy.ai", locale), text: content.ai },
];

const firstParagraph = paragraphs(content.problem)[0] ?? content.title;
const description =
  firstParagraph.length > 155 ? `${firstParagraph.slice(0, 154).trimEnd()}…` : firstParagraph;
---

<Layout title={`${content.title} | GambeTech`} description={description} headerTitle={content.title} locale={locale}>
  <article class="bg-white py-16" data-case-study={data.slug} data-kind={data.kind}>
    <div class="max-w-3xl mx-auto px-4 space-y-10">
      {sections.map(({ heading, text }) => (
        <section>
          <h2 class="text-2xl font-semibold text-primary mb-4">{heading}</h2>
          {paragraphs(text).map((p) => <p class="text-base text-text leading-relaxed mb-4">{p}</p>)}
        </section>
      ))}

      <section>
        <h2 class="text-2xl font-semibold text-primary mb-4">{t("caseStudy.stack", locale)}</h2>
        <ul class="flex flex-wrap gap-2">
          {content.stack.map((item) => <li><Badge variant="surface">{item}</Badge></li>)}
        </ul>
      </section>

      {closingSections.map(({ heading, text }) => (
        <section>
          <h2 class="text-2xl font-semibold text-primary mb-4">{heading}</h2>
          {paragraphs(text).map((p) => <p class="text-base text-text leading-relaxed mb-4">{p}</p>)}
        </section>
      ))}

      {data.kind === "product" && data.liveUrl && (
        <section>
          <Button
            variant="primary"
            href={data.liveUrl}
            rel="noopener"
            data-live-link
            data-umami-event="open-product"
            data-umami-event-slug={data.slug}
          >
            {t("caseStudy.liveLink", locale)}
          </Button>
        </section>
      )}

      {data.kind === "mission" && (
        <section>
          <h2 class="text-2xl font-semibold text-primary mb-4">{t("caseStudy.client", locale)}</h2>
          <p class="text-base text-text leading-relaxed mb-8">{data.client}</p>
          <h2 class="text-2xl font-semibold text-primary mb-4">{t("caseStudy.results", locale)}</h2>
          <ul class="list-disc pl-6 space-y-2">
            {data[locale].results.map((result) => <li class="text-base text-text leading-relaxed">{result}</li>)}
          </ul>
        </section>
      )}

      <section class="border-t border-surface pt-8">
        <Button
          variant="ghost"
          href={LINKEDIN_URL}
          rel="noopener"
          data-umami-event="contact-linkedin"
          data-umami-event-placement="case-study"
        >
          {t("caseStudy.contact", locale)}
        </Button>
      </section>
    </div>
  </article>
</Layout>
