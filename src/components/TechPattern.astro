---
interface Props {
  class?: string;
  density?: 'low' | 'medium' | 'high';
}

const { class: className = '', density = 'medium' } = Astro.props;

const tileSizes: Record<string, number> = {
  low: 120,
  medium: 80,
  high: 50,
};

const size = tileSizes[density];
const scale = size / 80;

// L-shaped circuit traces scaled from medium (80x80) base
// Line 1: horizontal (0,20) to (40,20)
// Line 2: vertical (40,20) to (40,60) - forms L with Line 1
// Line 3: vertical (60,0) to (60,40)
// Line 4: horizontal (60,40) to (80,40) - forms L with Line 3
const lines = [
  { x1: 0, y1: 20 * scale, x2: 40 * scale, y2: 20 * scale },
  { x1: 40 * scale, y1: 20 * scale, x2: 40 * scale, y2: 60 * scale },
  { x1: 60 * scale, y1: 0, x2: 60 * scale, y2: 40 * scale },
  { x1: 60 * scale, y1: 40 * scale, x2: size, y2: 40 * scale },
];

// Circles at intersections
const circles = [
  { cx: 40 * scale, cy: 20 * scale },
  { cx: 40 * scale, cy: 60 * scale },
  { cx: 60 * scale, cy: 40 * scale },
];

const patternId = `tech-pattern-${density}`;
---

<div class:list={["absolute inset-0 overflow-hidden pointer-events-none", className]}>
  <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern
        id={patternId}
        patternUnits="userSpaceOnUse"
        width={size}
        height={size}
      >
        {lines.map((line) => (
          <line
            x1={line.x1}
            y1={line.y1}
            x2={line.x2}
            y2={line.y2}
            stroke="#336D93"
            stroke-width="0.75"
            opacity="0.1"
          />
        ))}
        {circles.map((circle) => (
          <circle
            cx={circle.cx}
            cy={circle.cy}
            r="2"
            fill="#336D93"
            opacity="0.15"
          />
        ))}
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`} />
  </svg>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at center, rgba(255,255,255,0.04) 0%, transparent 70%)"
  ></div>
</div>
