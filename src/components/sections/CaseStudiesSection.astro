---
import CaseStudyCard from "../case-study/CaseStudyCard.astro";
import { getPublishedCaseStudies } from "../../lib/case-studies";
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
// Products first, then missions, by `order` (sorted by getPublishedCaseStudies).
const caseStudies = await getPublishedCaseStudies();
---

<section id="realisations" class="bg-white py-20 scroll-mt-20 reveal">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-semibold text-primary text-center mb-12">{t("home.caseStudies.title", locale)}</h2>
    {caseStudies.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {caseStudies.map((entry) => (
          <li><CaseStudyCard entry={entry} locale={locale} /></li>
        ))}
      </ul>
    ) : (
      <p class="text-center text-text-secondary">{t("home.caseStudies.empty", locale)}</p>
    )}
  </div>
</section>
