---
import TechPattern from "../TechPattern.astro";
import { SECTORS } from "../../consts";
import { countPublishedProducts } from "../../lib/case-studies";
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const productCount = await countPublishedProducts();

// Final values in the server HTML (no count-up): rule C13 reads the products number.
const metrics = [
  { id: "years", value: 15, suffix: "+", label: t("metrics.years", locale) },
  { id: "sectors", value: SECTORS.length, suffix: "", label: t("metrics.sectors", locale) },
  { id: "founded", value: 2020, suffix: "", label: t("metrics.founded", locale) },
  { id: "products", value: productCount, suffix: "", label: t("metrics.products", locale) },
];
---

<section id="chiffres" data-product-count={productCount} class="relative bg-primary py-12 scroll-mt-20 reveal">
  <TechPattern density="medium" />
  <div class="relative z-10 max-w-7xl mx-auto px-4">
    <h2 class="sr-only">{t("metrics.title", locale)}</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      {metrics.map((metric) => (
        <div>
          <p data-metric={metric.id} class="text-4xl md:text-5xl font-semibold text-white mb-2">{`${metric.value}${metric.suffix}`}</p>
          <p class="text-sm text-white/70">{metric.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
