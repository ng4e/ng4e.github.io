---
import Counter from "../ui/Counter.tsx";
---

<section id="chiffres" class="bg-primary py-20 scroll-mt-20 animate-on-scroll" data-animate>
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-semibold text-white text-center mb-12 uppercase tracking-wide">Experiences</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      <Counter client:visible value={15} suffix="+" label="Annees d'expertise cumulee" />
      <Counter client:visible value={5} suffix="" label="Secteurs strategiques" />
      <Counter client:visible value={2020} label="Annee de creation" isYear />
      <Counter client:visible value={4} suffix="" label="Produits" />
    </div>
  </div>
</section>
