---
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
---

<section id="philosophie" class="bg-white py-20 scroll-mt-20 reveal">
  <div class="max-w-3xl mx-auto px-4">
    <blockquote class="border-l-4 border-accent pl-6 text-left">
      <p class="text-xl md:text-2xl italic text-text mb-4 leading-relaxed">{t("philosophy.paragraph1", locale)}</p>
      <p class="text-base text-text-secondary mb-6 leading-relaxed">{t("philosophy.paragraph2", locale)}</p>
      <p class="text-lg font-semibold text-primary">{t("philosophy.paragraph3", locale)}</p>
    </blockquote>
  </div>
</section>
