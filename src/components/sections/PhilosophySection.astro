---
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
---

<section id="philosophie" class="bg-white py-20 scroll-mt-20 animate-on-scroll" data-animate>
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-surface rounded-2xl p-8 md:p-12">
      <p class="text-2xl md:text-3xl italic font-medium text-primary mb-4 leading-relaxed">{t("philosophy.paragraph1", locale)}</p>
      <p class="text-base text-text-secondary leading-relaxed mb-6">{t("philosophy.paragraph2", locale)}</p>
      <p class="text-lg font-semibold text-primary">{t("philosophy.paragraph3", locale)}</p>
    </div>
  </div>
</section>
