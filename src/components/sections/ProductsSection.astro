---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

const products = [
  {
    name: "NMT -- NG. Moving Together",
    tagline: "Reseau social familial",
    body: "Un reseau social familial avec arbre genealogique et journal de gratitude partage, a destination des familles eloignees par l'immigration.",
    cta: "Decouvrir le projet",
    href: "#",
  },
  {
    name: "Sportifs Prometteurs",
    tagline: "Gestion de tournois tennis",
    body: "Solution de programmation de tournois ITF a partir des performances et du budget. Aide les familles de jeunes joueurs a optimiser leur parcours vers la carriere professionnelle.",
    cta: "Decouvrir le projet",
    href: "https://getsp.sportifs-prometteurs.org",
  },
  {
    name: "Association Pirien",
    tagline: "Heritage culturel Bamoun",
    body: "Plateforme de preservation, valorisation et transmission de l'heritage culturel Bamoun au Cameroun. Inclut une boutique associative en ligne.",
    cta: "Decouvrir le projet",
    href: "https://why.pirien.com/",
  },
];
---

<section id="produits" class="bg-primary py-20 scroll-mt-20 animate-on-scroll" data-animate>
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-semibold text-white text-center mb-4">Nos Produits</h2>
    <p class="text-base text-white/70 text-center mb-12 max-w-2xl mx-auto">Creer de la valeur sur des problemes de niche</p>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {products.map((product, i) => (
        <div class="stagger-item" style={`--stagger-delay: ${i}`}>
          <Card variant="on-dark">
            <h3 class="text-xl font-semibold text-primary mb-1">{product.name}</h3>
            <p class="text-sm text-accent font-semibold mb-3">{product.tagline}</p>
            <p class="text-base text-text-secondary mb-6">{product.body}</p>
            <Button variant="primary" size="small" href={product.href}>{product.cta}</Button>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>
