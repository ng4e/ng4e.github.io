---
import Button from "../ui/Button.astro";
import TechPattern from "../TechPattern.astro";
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;

const products = [
  {
    name: "NMT — NG. Moving Together",
    taglineKey: "products.nmt.tagline",
    bodyKey: "products.nmt.body",
    ctaKey: "products.nmt.cta",
    href: "#",
  },
  {
    name: "Sportifs Prometteurs",
    taglineKey: "products.sp.tagline",
    bodyKey: "products.sp.body",
    ctaKey: "products.sp.cta",
    href: "https://getsp.sportifs-prometteurs.org",
  },
  {
    name: "Association Pirien",
    taglineKey: "products.pirien.tagline",
    bodyKey: "products.pirien.body",
    ctaKey: "products.pirien.cta",
    href: "https://why.pirien.com/",
  },
];
---

<section id="produits" class="scroll-mt-20 reveal">
  <!-- Dark header zone -->
  <div class="relative bg-primary py-16">
    <TechPattern density="medium" />
    <div class="relative z-10 max-w-7xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4">{t("products.title", locale)}</h2>
      <p class="text-base text-white/70 max-w-2xl mx-auto">{t("products.subtitle", locale)}</p>
    </div>
  </div>
  <!-- Cards zone -->
  <div class="bg-surface py-16">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
      {products.map((product, i) => (
        <div class={`stagger-item reveal-delay-${Math.min(i + 1, 3)}`} style={`--stagger-delay: ${i}`}>
          <div class="bg-white rounded-xl border border-gray-200 border-l-4 border-l-accent p-6 transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-lg">
            <h3 class="text-xl font-bold text-text mb-1">{product.name}</h3>
            <p class="text-sm font-semibold text-accent mb-3">{t(product.taglineKey, locale)}</p>
            <p class="text-sm text-text-secondary leading-relaxed mb-4">{t(product.bodyKey, locale)}</p>
            <Button variant="primary" size="small" href={product.href}>{t(product.ctaKey, locale)}</Button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
