---
import Button from "../ui/Button.astro";
import { LINKEDIN_URL } from "../../consts";
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
---

<section id="hero" class="relative">
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 40%, #243758 0%, #1B2A4A 70%);"></div>
  <div class="relative z-10 text-center text-white px-4 pt-32 pb-20 md:pt-40 md:pb-24 max-w-4xl mx-auto">
    <h1 class="text-2xl md:text-4xl font-semibold leading-snug mb-8">{t("hero.statement", locale)}</h1>
    {/* Keep this link: rule C2 needs a LinkedIn link inside <main> on both homes. */}
    <Button variant="ghost" size="small" href={LINKEDIN_URL} data-umami-event="contact-linkedin" data-umami-event-placement="home" class="border-white text-white hover:bg-white/10">{t("hero.contact", locale)}</Button>
  </div>
  <div id="nav-sentinel" class="absolute bottom-0 h-0" aria-hidden="true"></div>
</section>
