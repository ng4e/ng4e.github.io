---
import Button from "../ui/Button.astro";
import { t, type Locale } from "../../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
---

<section id="hero" class="relative min-h-screen flex items-center justify-center">
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 40%, #243758 0%, #1B2A4A 70%);">
    <slot name="background" />
  </div>
  <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-8xl font-bold uppercase tracking-widest mb-6">GAMBETECH</h1>
    <p class="text-xl md:text-2xl font-semibold mb-6">{t("hero.tagline", locale)}</p>
    <p class="text-base md:text-lg text-white/80 mb-10 max-w-2xl mx-auto leading-relaxed">{t("hero.description", locale)}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button variant="primary" href={`${prefix}/#produits`}>{t("hero.cta.products", locale)}</Button>
      <Button variant="ghost" href={`${prefix}/#competences`} class="border-white text-white hover:bg-white/10">{t("hero.cta.expertises", locale)}</Button>
    </div>
  </div>
  <div id="nav-sentinel" class="absolute bottom-0 h-0" aria-hidden="true"></div>
</section>
