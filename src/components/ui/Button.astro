---
interface Props {
  variant?: "primary" | "ghost";
  size?: "default" | "small";
  href?: string;
  class?: string;
}

const { variant = "primary", size = "default", href, class: className = "" } = Astro.props;

const baseClasses = "inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors duration-200";

const variantClasses = {
  primary: "bg-accent text-white hover:bg-[#2E6A8F]",
  ghost: "bg-transparent border border-accent text-accent hover:bg-accent/10",
};

const sizeClasses = {
  default: "h-12 px-6 text-base",
  small: "h-9 px-4 text-sm",
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className];
---

{href ? (
  <a href={href} class:list={classes}>
    {Astro.slots.has("icon") && <span class="inline-flex shrink-0"><slot name="icon" /></span>}
    <slot />
  </a>
) : (
  <button class:list={classes}>
    {Astro.slots.has("icon") && <span class="inline-flex shrink-0"><slot name="icon" /></span>}
    <slot />
  </button>
)}
