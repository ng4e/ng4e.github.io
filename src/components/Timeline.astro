---
// Timeline.astro
import TimelineAccordion from './TimelineAccordion.astro';
import type { Project } from '../consts';


const { projects } = Astro.props;
---

<div class="container">
  <div class="timeline-container">
    <div class="timeline">
      {
      projects && Array.isArray(projects)
      ? (projects.map((project:Project, index:number) => (
        <TimelineAccordion
          project={project}
          position={index % 2 === 0 ? 'left' : 'right'}
        />
      ))): (<p>No projects found.</p>)
      }
    </div>
  </div>
</div>

<style>
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .timeline-container {
    position: relative;
    padding: 1rem 0;
  }

  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background-color: #dbdbdb;
  }

  @media screen and (min-width: 769px) {
    .timeline {
      padding-left: 2rem;
    }
  }
</style>
