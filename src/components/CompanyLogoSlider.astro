---
import { companies } from "../consts";
---

<div class="overflow-hidden">
    <div class="flex logo-scroll">
        {companies.map(c => (
            <img src={c.logo} alt={c.name} loading="lazy" class="h-10 w-auto mx-8 shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300 ease-out" />
        ))}
        {companies.map(c => (
            <img src={c.logo} alt={c.name} aria-hidden="true" loading="lazy" class="h-10 w-auto mx-8 shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300 ease-out" />
        ))}
    </div>
</div>

<style>
@keyframes logo-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.logo-scroll {
    animation: logo-scroll 30s linear infinite;
    will-change: transform;
}
.logo-scroll:hover {
    animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
    .logo-scroll {
        animation: none;
    }
}
</style>
